<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Compose owns theming (Material3 dynamicColor / Monet) at runtime; this is only the
         launch/splash-safe base theme so the window doesn't flash unstyled before Compose loads. -->
    <style name="Theme.ShowTracker" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
    </style>
</resources>
